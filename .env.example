# ==============================================
# TradingBot23 Configuration
# Copy this file to .env and fill in your keys
# ==============================================

# --- API Keys (REQUIRED) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
CMC_API_KEY=your_coinmarketcap_api_key_here

# --- Trading Mode ---
# Options: "paper" (default, no real trades), "live" (real orders), "backtest"
TRADING_MODE=paper

# --- Capital & Position Sizing ---
CAPITAL_USD=10000
PER_TRADE_PCT=0.20

# --- Strategy Parameters ---
# Net take profit target AFTER fees (1% net default).
# Gross TP is auto-computed as: NET_TP_PCT + (2 * FEE_PCT)
NET_TP_PCT=0.01
# Binance spot fee per side (0.001 = 0.1%, or 0.00075 with BNB discount).
FEE_PCT=0.001
# Optional: override gross TP directly (uncomment to use).
# TP_PCT=0.012
SL_PCT=0.015
MAX_HOLD_DAYS=3
DIP_THRESHOLD_PCT=0.02

# --- Coin Selection ---
TOP_N_COINS=50
TOP_N_LOSERS=10
MIN_VOLUME_USD=50000000
SNAPSHOT_DAY=1

# --- Bot Operation ---
CHECK_INTERVAL_HOURS=1

# --- Binance Testnet (for paper trading) ---
BINANCE_TESTNET=false

# --- Logging ---
LOG_LEVEL=INFO
