# ================================================
# TradingBot23 — Configuration Template
# Copy this file to .env and fill in your values
# ================================================

# --- Binance API Keys ---
# Read-only keys are enough for paper trading.
# Enable "Spot & Margin Trading" for live spot mode.
# Enable "Futures Trading" for live futures mode (not yet implemented).
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Trading Mode ---
# paper = simulated trades only (safe default, no real money)
# live  = real orders on your Binance account
TRADING_MODE=paper

# --- Engine ---
# futures = USDT-M Perpetual Futures (recommended, lower fees, paper-only)
# spot    = Binance Spot (live or paper)
ENGINE=futures

# --- Capital & Sizing ---
CAPITAL_USD=500
PER_TRADE_PCT=0.20          # 20% of current portfolio per trade
MONTHLY_CONTRIBUTION_USD=0  # Paper cash added once per month (0 = disabled)
MONTHLY_CONTRIBUTION_DAY=1  # Day of month for monthly paper contribution

# --- Leverage (futures only) ---
# 1x = same risk as spot, lowest fee drag. Hard cap: 5x.
LEVERAGE=1

# --- Coin Universe ---
TOP_N_COINS=50              # Top N coins by market cap (CoinGecko, free, no key)
TOP_N_LOSERS=5              # Pick the N worst 24h performers as monthly basket

# --- Futures Profit / Risk Targets ---
FUTURES_NET_TP_PCT=0.01     # 1% net take-profit after all fees
FUTURES_NET_SL_PCT=0.015    # 1.5% net stop-loss reference
FUTURES_USE_SL=false        # Disable SL — top-50 coins historically rebound
FUTURES_FEE_PCT=0.0006      # 0.06% taker fee (Binance USDT-M)
FUNDING_RATE_DAILY=0.0003   # ~0.03%/day funding drag (historical average)

# --- Spot Profit / Risk Targets (only used when ENGINE=spot) ---
NET_TP_PCT=0.01
NET_SL_PCT=0.015
FEE_PCT=0.001               # 0.1% per side (use 0.00075 with BNB discount)

# --- Timing ---
DIP_THRESHOLD_PCT=0.02      # Entry trigger: -2% 24h change
MAX_HOLD_DAYS=3             # Auto-close positions after 3 days
POSITION_CHECK_MINS=5       # Full scan interval (dip detection + TP/SL check)

# --- Win-Rate Enhancers ---
BREAK_EVEN_TRIGGER_PCT=0.005  # Slide SL to break-even after +0.5% move (0 = disable)
LOSS_COOLDOWN_HOURS=24        # Skip a coin for N hours after SL hit (0 = disable)
TP_COOLDOWN_HOURS=1           # Skip a coin for N hours after TP hit (0 = disable)

# --- Crash Protection ---
# If BTC drops more than this in 24h, crash mode activates:
#   - All new entries are blocked
#   - Emergency SL is set 3% below current price on all open positions
# Based on historical crashes: May 2021 (-30%), Nov 2022 (-16%), Aug 2024 (-9%)
CRASH_BTC_TRIGGER_PCT=-0.08      # -8% BTC 24h triggers crash mode
CRASH_BTC_RECOVERY_PCT=-0.05     # -5% BTC 24h to resume normal trading
CRASH_SL_PCT=0.03                # Emergency SL = 3% below current price

# --- Telegram Alerts (optional) ---
# 1. Message @BotFather on Telegram -> /newbot -> copy token
# 2. Message @userinfobot -> copy your chat ID
# Leave blank to disable alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Misc ---
BINANCE_TESTNET=false
LOG_LEVEL=INFO
