# ================================================
# TradingBot23 — Configuration Template
# Copy this file to .env and fill in your values
# ================================================

# --- Binance API Keys ---
# Read-only keys are enough for paper trading.
# Futures execution is paper-only in this app.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Trading Mode ---
# paper = simulated trades only (safe default, no real money)
# backtest = historical simulation from the CLI
TRADING_MODE=paper

# --- Engine ---
# Futures-only. Spot trading is intentionally not supported.
ENGINE=futures

# --- Capital & Sizing ---
CAPITAL_USD=500
PER_TRADE_PCT=0.20          # 20% of current portfolio per trade
MONTHLY_CONTRIBUTION_USD=0  # Paper cash added once per month (0 = disabled)
MONTHLY_CONTRIBUTION_DAY=1  # Day of month for monthly paper contribution

# --- Leverage (futures only) ---
# 1x default keeps liquidation risk low. Paper-only cap: 20x.
LEVERAGE=1

# --- Coin Universe ---
TOP_N_COINS=50              # Top N coins by market cap (CoinGecko, free, no key)
TOP_N_LOSERS=5              # Pick the N worst 24h performers as monthly basket
MAX_OPEN_TRADES=5           # Max simultaneous futures paper positions (1-10)

# --- AI-Style Entry Guards ---
PRE_TRADE_ANALYSIS_ENABLED=true
PRE_TRADE_MIN_SCORE=60
PRE_TRADE_BREAKDOWN_GUARD_ENABLED=true
PRE_TRADE_MAX_24H_DROP_PCT=8.0
PRE_TRADE_MAX_LOWER_CLOSE_STREAK=5
PRE_TRADE_MAX_BELOW_SMA20_PCT=1.5
PRE_TRADE_MIN_BREAKDOWN_REBOUND_PCT=1.0
PAPER_SYMBOL_GUARD_ENABLED=true
PAPER_SYMBOL_GUARD_LOOKBACK_DAYS=30
PAPER_SYMBOL_GUARD_MAX_REALIZED_LOSS_USD=50
PAPER_SYMBOL_GUARD_EXPIRED_LOSS_USD=25
PAPER_SYMBOL_GUARD_BLOCK_LIQUIDATED=true

# --- Futures Profit / Risk Targets ---
FUTURES_NET_TP_PCT=0.01     # 1% net take-profit after all fees
FUTURES_NET_SL_PCT=0.015    # 1.5% net stop-loss reference
FUTURES_USE_SL=false        # Disable SL — top-50 coins historically rebound
FUTURES_FEE_PCT=0.0006      # 0.06% taker fee (Binance USDT-M)
FUNDING_RATE_DAILY=0.0003   # ~0.03%/day funding drag (historical average)

# --- Timing ---
DIP_THRESHOLD_PCT=0.02      # Entry trigger: -2% 24h change
MAX_HOLD_DAYS=3             # Auto-close positions after 3 days
POSITION_CHECK_MINS=5       # Full scan interval (dip detection + TP/SL check)
AUTO_START_FUTURES=false    # Keep new installs paused until you press Resume
SETTINGS_CONFIRMED=false    # Set true by the app after Apply Settings
BOT_PROFILE=default         # Change per beta tester to isolate local paper data

# --- Professional Risk Controls ---
# Zero disables a limit. Enforced by the desktop dashboard loop.
RISK_MAX_DAILY_LOSS_USD=0
RISK_MAX_OPEN_EXPOSURE_USD=0
RISK_MAX_LOSS_STREAK=0

# --- P2P Paper Realism ---
P2P_MAX_ROUTE_PHP=0          # 0 = use the P2P tab capital field
P2P_DEFAULT_CAPITAL_PHP=500000
P2P_MIN_NET_PCT=0.10
P2P_TRANSFER_FEE_USDT=1.0
P2P_BUFFER_PHP=0
P2P_SETTLEMENT_DELAY_MINS=20
P2P_CANCEL_RATE_PCT=2
P2P_SPREAD_DECAY_PCT=0.03
P2P_MODE=paper
P2P_TG_ALERTS=true
P2P_AUTO_CYCLE=false
P2P_AUTO_HOLD_SELL=true
P2P_AUTO_WATCH_LOG=false

# --- Win-Rate Enhancers ---
BREAK_EVEN_TRIGGER_PCT=0.005  # Slide SL to break-even after +0.5% move (0 = disable)
LOSS_COOLDOWN_HOURS=24        # Skip a coin for N hours after SL hit (0 = disable)
TP_COOLDOWN_HOURS=1           # Skip a coin for N hours after TP hit (0 = disable)

# --- Pre-Trade Wave Analysis ---
PRE_TRADE_ANALYSIS_ENABLED=true
PRE_TRADE_MIN_SCORE=60
PRE_TRADE_MIN_REBOUND_PCT=0.35
PRE_TRADE_MAX_1H_DROP_PCT=0.75
PRE_TRADE_MAX_4H_DROP_PCT=2.50
PRE_TRADE_MIN_24H_RANGE_PCT=1.20

# --- Crash Protection ---
# If BTC drops more than this in 24h, crash mode activates:
#   - All new entries are blocked
#   - Emergency SL is set below current price on all open positions
# 20x paper mode needs an earlier guard than historical full-crash thresholds.
CRASH_BTC_TRIGGER_PCT=-0.04      # -4% BTC 24h triggers crash mode
CRASH_BTC_RECOVERY_PCT=-0.02     # -2% BTC 24h to resume normal trading
CRASH_SL_PCT=0.015               # Emergency SL = 1.5% below current price

# --- Telegram Alerts (optional) ---
# 1. Message @BotFather on Telegram -> /newbot -> copy token
# 2. Message @userinfobot -> copy your chat ID
# Leave blank to disable alerts and Telegram dashboard commands.
# Commands after restart: /dashboard, /p2p, /today, /export, /info, /menu
# Set true only if you want Telegram to be able to pause/resume futures trading.
TELEGRAM_ALLOW_CONTROL=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ohverlay Local Overlay Notifications (optional) ---
# Requires Ohverlay v4 Webhook Server enabled from the Ohverlay tray menu.
OHVERLAY_ENABLED=false
OHVERLAY_WEBHOOK_URL=http://127.0.0.1:7277/message
OHVERLAY_SENDER=TradingBot23
OHVERLAY_TIMEOUT_SECS=2.0
OHVERLAY_MAX_CHARS=420

# --- Misc ---
BINANCE_TESTNET=false
LOG_LEVEL=INFO
