# ==============================================
# TradingBot23 Configuration
# Copy this file to .env and fill in your keys
# ==============================================

# --- API Keys (REQUIRED) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
CMC_API_KEY=your_coinmarketcap_api_key_here

# --- Trading Mode ---
# Options: "paper" (default, no real trades), "live" (real orders), "backtest"
TRADING_MODE=paper

# --- Capital & Position Sizing ---
CAPITAL_USD=10000
PER_TRADE_PCT=0.20

# --- Strategy Parameters ---
# NET take profit target AFTER fees. Gross TP = NET_TP_PCT + 2 * FEE_PCT.
# Examples:
#   0.01    = 1.0% net  (recommended, balanced risk/reward)
#   0.005   = 0.5% net  (scalper mode, needs ~75% win rate to be profitable)
#   0.0025  = 0.25% net (extreme scalping, needs ~85% win rate, high churn)
#   0.02    = 2.0% net  (original Chimera spec, slower but safer)
NET_TP_PCT=0.01

# NET stop loss tolerance AFTER fees. Set proportional to NET_TP_PCT
# to keep risk:reward favorable. For very small TPs, also tighten SL.
NET_SL_PCT=0.015

# Binance spot fee per side (0.001 = 0.1%, or 0.00075 with BNB discount).
FEE_PCT=0.001

# Optional manual overrides (uncomment to use instead of auto-computed):
# TP_PCT=0.012
# SL_PCT=0.013

MAX_HOLD_DAYS=3
DIP_THRESHOLD_PCT=0.02

# --- Win-rate enhancers ---
# Once unrealized PNL crosses +0.5%, slide SL up to entry+fees.
# Converts many losers into break-evens. Set to 0 to disable.
BREAK_EVEN_TRIGGER_PCT=0.005
# After a STOP-LOSS hit on a coin, refuse new entries on it for N hours.
# Stops stacking losses on a coin in a clear downtrend. Set to 0 to disable.
LOSS_COOLDOWN_HOURS=24
# Skip entries when BTC 1h change is below this. Set to "none" to disable.
BTC_REGIME_FILTER_PCT=-0.015

# --- Coin Selection ---
TOP_N_COINS=50
TOP_N_LOSERS=10
MIN_VOLUME_USD=50000000
SNAPSHOT_DAY=1

# --- Bot Operation ---
CHECK_INTERVAL_HOURS=1

# --- Engine: "spot" (default) or "futures" (paper-only USDT-M perps) ---
ENGINE=spot

# --- Futures settings (only used when ENGINE=futures) ---
LEVERAGE=2
FUTURES_FEE_PCT=0.0006
FUNDING_RATE_DAILY=0.0003
FUTURES_NET_TP_PCT=0.005
FUTURES_NET_SL_PCT=0.0075
FUTURES_DIP_THRESHOLD_PCT=0.005

# --- Binance Testnet (for paper trading) ---
BINANCE_TESTNET=false

# --- Logging ---
LOG_LEVEL=INFO
